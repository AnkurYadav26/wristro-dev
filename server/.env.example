# ---- Browser/client ----
# Comma-separated list of allowed frontend origins (CORS + CSRF origin check)
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173,http://localhost:5174,http://127.0.0.1:5174,http://[::1]:5174
# Use "none" only if the frontend and API are on different sites (requires HTTPS)
COOKIE_SAMESITE=lax
# Number of reverse proxies in front of the app (Render/Heroku/Nginx = 1)
TRUST_PROXY=0

# ---- Email (required in production) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=rydosphere@gmail.com
SMTP_PASS=quno nzly bvgk ujgb
MAIL_FROM="WRISTORA <rydosphere@gmail.com>"

# ---- Business rules ----
# Coupon whose price is advertised on product pages ("₹X with WATCH60")
PROMO_COUPON_CODE=WATCH60
DEFAULT_DISCOUNT_PERCENT=40
STOCK_RESERVATION_MINUTES=15
MAX_QTY_PER_LINE=10
# Shipping (paise). Flat fee below the free-shipping line; use FREE_SHIPPING_ABOVE_PAISE=none to always charge.
SHIPPING_FLAT_PAISE=9900
FREE_SHIPPING_ABOVE_PAISE=99900
CART_MAX_ITEMS=30
MAX_ADDRESSES=10
# India Post PIN lookup (free, best-effort; checkout still works if it is down)
PINCODE_API_URL=https://api.postalpincode.in/pincode

# ---- Payments (Razorpay) ----
# Leave blank to use the built-in SIMULATED gateway in development (no real money, no account needed).
# Drop in your TEST keys from https://dashboard.razorpay.com/app/keys to switch to the real flow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set this to "your_webhook_secret" after adding the webhook endpoint in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# ---- Image hosting (Cloudinary) ----
# From https://console.cloudinary.com/app/settings/api-keys . Leave blank to disable uploads
# (you can still paste image URLs by hand in the admin product form).
CLOUDINARY_CLOUD_NAME=doxw1ewde
CLOUDINARY_API_KEY=919599967694434
CLOUDINARY_API_SECRET=u02Gs-lge-GmD787_NZuK24BVyo
# Folder that uploaded product images are stored in.
CLOUDINARY_FOLDER=Dynamic folders

# ---- Seed script only ----
